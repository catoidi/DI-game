//zscript_DI/shop/modifiers/valuepack.zsc

Class DI_ShopMod_ValuePack : DI_ShopMod
{
	Default
	{
		DIShopInventory.ForceReroll true;
	}

	override string SimpleShopPopup()
	{
		return "$DI_SHOPMOD_VALUEPACK";
	}
	
	override double MultiplyPrice(string curitem)
	{
		return 2.0 * amount;
	}
	
	override void DidPurchase(DI_PlayerBase buyer, actor newitem)
	{
		if (newitem is "Inventory")
		{
			let inv = Inventory(newitem);
			inv.amount *= (2 * amount);
		}
	}
}