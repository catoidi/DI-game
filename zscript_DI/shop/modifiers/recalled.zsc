//zscript_DI/shop/modifiers/recalled.zsc

Class DI_ShopMod_Recalled : DI_ShopMod
{
	Default
	{
		DI_ShopMod.ParticleColor "FF0000";
	}

	override string SimpleShopPopup()
	{
		return "$DI_SHOPMOD_RECALLED";
	}
	
	string newdebuff, newdebuff_name, newdebuff_desc;
	
	virtual string, string GetSideQuest(DI_PlayerBase plr)
	{
		if (plr && plr.popuphandler)
		{
			string objective, debuff;
			[objective, debuff] = plr.popuphandler.ChooseQuestAlt();
			return objective, debuff;
		}
		else {return "", "";}
	}
	
	virtual void SpawnDebuff(DI_PlayerBase plr)
	{
		string objective, debuff;
		if (newdebuff && (random(0, 1) != 1))
		{
			debuff = newdebuff;
		}
		else
		{
			[debuff, objective] = GetSideQuest(plr);
			newdebuff = debuff;
			newdebuff_name = stringtable.localize(string.format("$SHOPITEM_%s", debuff));
			newdebuff_desc = stringtable.localize(string.format("$SHOPDESC_%s", debuff));
		}
		
		plr.GiveInventory(debuff, 1);
		ACS_ScriptCall("DI_Debilitated", plr.tid);
	}
	
	override void DidPurchase(DI_PlayerBase buyer, actor newitem)
	{
		if (random[dishop](0, 3) == 0) {SpawnDebuff(buyer);};
	}
	
	override double MultiplyPrice(string curitem)
	{
		return 0.75;
	}
}